#!/bin/bash
set -e

#This script is only to reset the containers 

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../.env"

NUM_CONTAINERS=$num_containers
DOCKER_IMAGE="workshop-desktop:latest"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --containers)
      NUM_CONTAINERS="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [--containers N]"
      echo "  --containers N   Number of workshop-N containers to reset (default: $NUM_CONTAINERS)"
      exit 0
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

if ! [[ "$NUM_CONTAINERS" =~ ^[0-9]+$ ]] || [ "$NUM_CONTAINERS" -eq 0 ]; then
  echo "ERROR: --containers must be a positive integer, got: '$NUM_CONTAINERS'" >&2
  exit 1
fi

echo "=== Workshop Teardown: $(date) ==="
echo "Recreating $NUM_CONTAINERS containers fresh from $DOCKER_IMAGE..."

for i in $(seq 1 $NUM_CONTAINERS); do
  PORT=$((START_PORT + i - 1))
  CONTAINER_NAME="workshop-${i}"

  echo "--- Resetting $CONTAINER_NAME (port $PORT) ---"

  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

  docker run -d \
    --name "$CONTAINER_NAME" \
    -p ${PORT}:3389 \
    --memory="768m" \
    --cpus="0.4" \
    --shm-size="512m" \
    "$DOCKER_IMAGE"

  echo "  $CONTAINER_NAME reset."
done

echo ""
echo "=== Teardown complete: $(date) ==="
echo "All $NUM_CONTAINERS containers recreated fresh. Guacamole connections unaffected."

